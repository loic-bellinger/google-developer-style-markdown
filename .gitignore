# Nothing is ignored by default in git, not even dotfiles, so caches and local
# state have to be listed explicitly.

# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/

# Tool caches
.ruff_cache/
.rumdl_cache/
.pytest_cache/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
